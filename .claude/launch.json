{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "backend"],
      "port": 4000
    },
    {
      "name": "backend-staff-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MANAGER_ALLOWED_EMAILS=singlahimanshi2@gmail.com,staff.dev@example.com",
        "POS_ALLOWED_EMAILS=singlahimanshi2@gmail.com,staff.dev@example.com",
        "npm",
        "run",
        "dev",
        "-w",
        "backend"
      ],
      "port": 4000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "frontend"],
      "port": 5173
    },
    {
      "name": "backend-alt-port",
      "runtimeExecutable": "env",
      "runtimeArgs": ["FRONTEND_URL=http://localhost:5176", "npm", "run", "dev", "-w", "backend"],
      "port": 4000
    },
    {
      "name": "frontend-alt-port",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "frontend", "--", "--port", "5176", "--strictPort"],
      "port": 5176
    },
    {
      "name": "backend-preview-content",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgresql://eklavya@localhost:5432/campuscart_dev",
        "PORT=4102",
        "FRONTEND_URL=http://localhost:5176",
        "BACKEND_URL=http://localhost:4102",
        "DEV_LOGIN_ENABLED=true",
        "npm",
        "run",
        "dev",
        "-w",
        "backend"
      ],
      "port": 4102
    },
    {
      "name": "frontend-preview-content",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CAMPUSCART_BACKEND_URL=http://localhost:4102",
        "npm",
        "run",
        "dev",
        "-w",
        "frontend",
        "--",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    }
  ]
}
