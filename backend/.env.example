# ─── CampusCart backend configuration ───────────────────────────────────────
# Copy to .env (development) and .env.test (automated tests). Never commit real values.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL. Use a separate database for tests (its name must end in _test).
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/campuscart_dev

# Where the browser app and the API are reached. In development the Vite dev
# server proxies /api to the backend, so both are used from localhost:5173.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ─── Authentication ──────────────────────────────────────────────────────────
# REQUIRED. At least 32 random characters, e.g. output of: openssl rand -base64 48
SESSION_SECRET=
# From Google Cloud Console → APIs & Services → Credentials (see docs/google-oauth-setup.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback

# Max sign-in attempts per IP address per 15 minutes
AUTH_RATE_LIMIT_MAX=30
# Which reverse proxies to trust for the visitor's IP address (rate limits depend on it).
# "loopback" = proxy on this machine; "1" = exactly one proxy in front; or proxy IPs/subnets.
TRUST_PROXY=loopback
# Max recharges / checkouts / cancellations / payment outcomes per user per minute
MONEY_RATE_LIMIT_PER_MIN=20

# ─── Pickup verification (optional; defaults shown) ─────────────────────────
# PICKUP_CODE_DIGITS=6
# PICKUP_CODE_TTL_MINUTES=720
# Orders each outlet takes on per rolling 3 minutes. Must be 10 in production; only test setups
# (the browser end-to-end suite) raise it.
ORDER_CAPACITY_PER_WINDOW=10

# Comma-separated. Grants the role only when a NEW account is created with a
# Google-verified email on the list. Changing a list never changes existing users.
MANAGER_ALLOWED_EMAILS=singlahimanshi2@gmail.com
POS_ALLOWED_EMAILS=singlahimanshi2@gmail.com

# ─── Development / test only — the server refuses to start in production if true ──
PAYMENT_MOCK_ENABLED=true
# Developer login: sign in as any email without Google, for local work and automated
# tests only. Accounts it creates are marked as developer accounts.
DEV_LOGIN_ENABLED=false

# ─── Wallet limits (in paise: ₹1 = 100 paise) ────────────────────────────────
# ₹99 (9900) is the business minimum; a lower value here is ignored, a higher one applies.
WALLET_RECHARGE_MIN_PAISE=9900
WALLET_RECHARGE_MAX_PAISE=200000
WALLET_MAX_BALANCE_PAISE=500000
